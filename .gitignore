# Ignore everything by default; allow only what belongs in the repo.
*
!*/

!/.gitignore
!/README.md
!/LICENSE
!/package.json
!/package-lock.json
!/tsconfig.json
!/vercel.json

!/api/*.ts
!/src/*.ts
!/src/*.html
!/src/*.css
!/src/*.js
!/src/*.tsq
!/src/docs/*.md
!/examples/*.tsq
!/assets/*.png
!/assets/*.svg
